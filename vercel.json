{
  "buildCommand": "cd omniagent && npm install && npm run build",
  "outputDirectory": "omniagent/dist/public",
  "installCommand": "cd omniagent && npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://omniagent-public-services-assistant-production.up.railway.app/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
