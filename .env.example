# =============================================================================
# LLM provider (ollama is the compatibility-preserving default)
# =============================================================================
LLM_PROVIDER=ollama

# Ollama (when the backend runs in Docker, use host.docker.internal for host Ollama)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT=180
OLLAMA_CONTEXT_WINDOW=8192

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Application settings (examples)
DATABASE_URL=sqlite:///./omniagent.db
JWT_SECRET_KEY=dev-secret-key-change-me
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
